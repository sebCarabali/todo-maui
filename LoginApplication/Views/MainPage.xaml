<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoginApplication.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <!-- Title -->
            <Label 
            Text="Welcome Back"
            FontSize="24"
            HorizontalOptions="Center"
            Margin="0,20,0,30" />

            <!-- Username field -->
            <Label 
            Text="Username"
            FontAttributes="Bold" 
            Margin="0,0,0,5" />
            <Entry 
            Placeholder="Enter username"
            Text="{Binding UserName, Mode=TwoWay}"
            ClearButtonVisibility="WhileEditing"
            Margin="0,0,0,15" />

            <!-- Password field -->
            <Label 
            Text="Password"
            FontAttributes="Bold"
            Margin="0,0,0,5" />
            <Entry 
            Placeholder="Enter password"
            Text="{Binding Password, Mode=TwoWay}"
            IsPassword="True"
            ClearButtonVisibility="WhileEditing"
            Margin="0,0,0,25" />

            <!-- Login button  -->
            <!--IsEnabled="{Binding IsNotBusy}"-->
            <Button 
            Text="Login"
            Command="{Binding LoginCommand}"
            BackgroundColor="#3E92CC"
            TextColor="White"
            Margin="0,0,0,15" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
