<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LoginApplication.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Reconocimiento Facial"
    BackgroundColor="{AppThemeBinding Light=White,
                                      Dark=#1C1C1E}">

    <Grid Margin="20" RowDefinitions="Auto,*">
        <!--  Title Section  -->
        <StackLayout Grid.Row="0" Padding="0,20">
            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="Center"
                Text="RECONOCIMIENTO FACIAL"
                TextColor="{AppThemeBinding Light=#2b0b98,
                                            Dark=White}" />

            <BoxView
                Margin="0,10"
                HeightRequest="2"
                HorizontalOptions="Fill"
                Color="{AppThemeBinding Light=#2b0b98,
                                        Dark=#a6a1f7}" />
        </StackLayout>

        <!--  Buttons Section  -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="20"
            RowSpacing="20"
            VerticalOptions="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Register User Button  -->
            <Button
                Grid.Column="0"
                BackgroundColor="{StaticResource Primary}"
                Clicked="OnRegisterButtonClicked"
                CornerRadius="10"
                FontAttributes="Bold"
                HeightRequest="60"
                Text="Registrar Usuario"
                TextColor="White" />

            <!--  Authorize User Button  -->
            <Button
                Grid.Column="1"
                BackgroundColor="{StaticResource Primary}"
                Clicked="OnAuthenticateButtonClicked"
                CornerRadius="10"
                FontAttributes="Bold"
                HeightRequest="60"
                Text="Autorizar Usuario"
                TextColor="White" />
        </Grid>
    </Grid>
</ContentPage>